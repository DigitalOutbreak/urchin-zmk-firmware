 * SPDX-License-Identifier: MIT
 *
 * US / ANSI conversion of duckyb's Urchin keymap.
 * Original assumed an Italian OS input source; this version assumes
 * US (ABC) and targets macOS for the clipboard shortcuts.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

// Layer definitions
#define BASE 0
#define SYM 1
#define EXT 2
#define FNC 3
#define AERO 4
#define SYM2 5
#define SETTINGS 6
// -----------------

&sk {
	// don't release mods on other mods presses
	ignore-modifiers;
};


/ {
	behaviors {
		// Aero dual roles: A taps Escape/holds Shift; V taps Herdr prefix/holds Ctrl.
		aero_dual: aero_dual_role {
			compatible = "zmk,behavior-hold-tap";
			label = "AERO_DUAL";
			#binding-cells = <2>;
			flavor = "hold-preferred";
			tapping-term-ms = <200>;
			quick-tap-ms = <175>;
			bindings = <&kp>, <&kp>;
		};

		// Preserve the proven right-inner Space behavior from the known-good firmware.
		aero: aero_tap {
			compatible = "zmk,behavior-hold-tap";
			label = "AERO_TAP";
			#binding-cells = <2>;
			flavor = "balanced";
			tapping-term-ms = <200>;
			quick-tap-ms = <175>;
			require-prior-idle-ms = <150>;
			bindings = <&mo>, <&kp>;
		};
	};

	conditional_layers {
		compatible = "zmk,conditional-layers";
		sym2_when_aero_and_sym {
			if-layers = <AERO SYM>;
			then-layer = <SYM2>;
		};
	};

	macros {
		// sometimes my device thinks a modifier is being held down
		// pressing all modifiers fixes it.
		unstick: unstick {
			label = "ZM_unstick";
			compatible = "zmk,behavior-macro";
			#binding-cells = <0>;
			bindings = <&kp LSHIFT &kp RSHIFT &kp LCTRL &kp RCTRL &kp LALT &kp RALT &kp LGUI &kp RGUI>;
		};
	};

	combos {
		compatible = "zmk,combos";
		// both left thumb keys
		combo_settings {
			timeout-ms = <200>;
			key-positions = <30 31>;
			bindings = <&mo SETTINGS>;
		};
		// J + K -> Escape. "jk" is not a digraph in English, so this can't
		// collide with normal typing. timeout-ms is the only delay a lone J
		// ever sees (45ms, vs the 1000ms a vim inoremap would cost), and
		// require-prior-idle-ms disables the combo entirely mid-word, so
		// there is no delay at all while you're actually typing.
		combo_esc {
			timeout-ms = <45>;
			require-prior-idle-ms = <50>;
			key-positions = <16 17>;
			bindings = <&kp ESC>;
			layers = <BASE>;
		};

		// J + L -> Enter. Right hand only, so Enter no longer needs the left
		// thumb for the Mods layer. Index + ring skipping the middle: an easy
		// pinch, and "jl" appears 8 times in a 236k-word dictionary.
		combo_enter {
			timeout-ms = <45>;
			require-prior-idle-ms = <50>;
			key-positions = <16 18>;
			bindings = <&kp ENTER>;
			layers = <BASE>;
		};
	};

	keymap {
		compatible = "zmk,keymap";
		// Base alpha layer -- standard US QWERTY block
		default_layer {
			label = "Base";
			bindings = <
			&kp Q &kp W &kp E &kp R &kp T           &kp Y &kp U  &kp I     &kp O   &kp P
			&kp A &kp S &kp D &kp F &kp G           &kp H &kp J  &kp K     &kp L   &kp SEMI
			&kp Z &kp X &kp C &kp V &kp B           &kp N &kp M  &kp COMMA &kp DOT &kp FSLH
							&mo EXT &mo AERO                                   &aero AERO SPACE &sl SYM
			>;
		};

		// Numbers and high frequency symbols
		// Left hand pairs open/close vertically: < >  ( )  { }  [ ]
		sym_layer {
			label = "Sym.";
			bindings = <
			&kp N1 &kp N2    &kp N3   &kp N4   &kp N5             &kp N6    &kp N7    &kp N8  &kp N9    &kp N0
			&kp LT &kp DLLR  &kp LPAR &kp LBRC &kp LBKT           &kp EQUAL &kp QMARK &kp SQT &kp MINUS &kp STAR
			&kp GT &kp PRCNT &kp RPAR &kp RBRC &kp RBKT           &kp AT    &kp EXCL  &kp DQT &kp PLUS  &kp FSLH
														&mo FNC &mo AERO                         &trans &trans
			>;
		};

		// Main modifiers and arrow keys
		ext_layer {
			label = "Mods";
			bindings = <
			&sk LALT  &kp C_PREV &kp C_PP &kp C_NEXT &kp C_PAUSE       &kp PG_UP &kp HOME &kp UP   &kp END &kp CAPS
			&kp ESC   &sk LGUI   &sk LSHIFT &sk LCTRL  &kp RALT        &kp PG_DN &kp LEFT &kp DOWN &kp RIGHT &kp DEL
			&kp LG(Z) &kp LG(X)  &kp LG(C)  &kp LG(V)  &kp TAB       &kp LA(BSPC) &kp BSPC &trans   &trans    &trans
																		&trans &kp LCTRL                         &mo FNC &kp ENTER
			>;
		};

		// Function keys with modifiers
		fnc_layer {
			label = "FRow";
			bindings = <
			&kp F1 &kp F2 &kp F3 &kp F4 &kp F5                  &kp F6 &kp F7 &kp F8 &kp F9 &kp F10
			&sk LALT &sk LGUI &sk LSHIFT &sk LCTRL &kp RALT     &kp F11 &kp F12  &kp PRINTSCREEN &trans &trans
			&kp LA(V) &none &none &kp LC(LA(H)) &kp LC(LA(L))       &none &none &none &none &none
							  &none &none                         &none &none
			>;
		};

		// Aerospace window management. Hold the dedicated left inner thumb.
		// Mirrors ~/.aerospace.toml, which uses alt as its modifier.
		aero_layer {
			label = "Aero";
			bindings = <
			// Aerospace shortcuts are shifted: alt-` = ws1, alt-1 = ws2, ... alt-9 = ws0.
			// Labels below describe the destination workspace, not the number sent.
			// Left top keeps mnemonic Chrome positions: W closes and T opens a tab.
			&kp TAB &kp LG(W) &kp LG(L) &kp LG(R) &kp LG(T)  &kp LA(N9) &kp LA(N4) &kp LC(LS(TAB)) &kp LC(TAB) &kp LA(N5)
			&aero_dual LSHIFT ESC &kp LA(GRAVE) &kp LA(N1) &kp LA(N2) &kp LA(N3)  &kp LA(H) &kp LA(J) &kp LA(K) &kp LA(L) &kp ENTER
			// Frequent actions replace retired workspace 7/8 positions on the left bottom row.
			&kp LG(LS(A)) &kp LA(SPACE) &kp ENTER &aero_dual LCTRL LC(B) &kp LA(N8)       &kp LA(SLASH) &kp BSPC &kp LA(COMMA) &kp LA(MINUS) &kp LA(EQUAL)
			// Keep all thumbs transparent. Contextual thumb overrides caused the
			// right thumb row to become unusable in the unified Aero revision.
									&trans &trans                         &trans &trans
			>;
		};

		// Low-frequency coding symbols. This layer automatically activates whenever
		// Aero and Sym are both held, regardless of which thumb was pressed first.
		symbols_2_layer {
			label = "Sym.2";
			bindings = <
			&kp CARET &kp UNDER &kp HASH &kp COLON &kp SEMI            &none &none &none &none &none
			&kp GRAVE &kp TILDE &kp BSLH &kp PIPE  &kp AMPS            &none &none &none &none &none
			&none     &none     &none    &none     &none               &none &none &none &none &none
																	&none &none                         &none &none
			>;
		};
		// Used to change the keyboard's settings.
		settings_layer {
				label = "Sett.";
				bindings = <
				&bootloader &none &none &bt BT_CLR &bt BT_SEL 0               &bt BT_SEL 3 &none &unstick &none &bootloader
				&none &none &none &none      &bt BT_SEL 1 						  &bt BT_SEL 4 &none &none &none &none
				&studio_unlock &none &kp LG(LC(LS(N4))) &none      &bt BT_SEL 2               &bt BT_SEL 5 &none &none &none &studio_unlock
										&none &none                         &none &none
				>;
		};
	};
};
