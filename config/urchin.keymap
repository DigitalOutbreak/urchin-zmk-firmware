/*
 * Copyright (c) 2020 duckyb
 *
 * SPDX-License-Identifier: MIT
 *
 * US / ANSI conversion of duckyb's Urchin keymap.
 * Original assumed an Italian OS input source; this version assumes
 * US (ABC) and targets macOS for the clipboard shortcuts.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

// Layer definitions
#define BASE 0
#define SYM 1
#define EXT 2
#define FNC 3
#define SYM2 4
#define AERO 5
#define SETTINGS 6
// -----------------

&sk {
	// don't release mods on other mods presses
	ignore-modifiers;
};


/ {
	macros {
		// sometimes my device thinks a modifier is being held down
		// pressing all modifiers fixes it.
		unstick: unstick {
			label = "ZM_unstick";
			compatible = "zmk,behavior-macro";
			#binding-cells = <0>;
			bindings = <&kp LSHIFT &kp RSHIFT &kp LCTRL &kp RCTRL &kp LALT &kp RALT &kp LGUI &kp RGUI>;
		};
	};

	combos {
		compatible = "zmk,combos";
		// both left thumb keys
		combo_settings {
			timeout-ms = <200>;
			key-positions = <30 31>;
			bindings = <&mo SETTINGS>;
		};
		// J + K -> Escape. "jk" is not a digraph in English, so this can't
		// collide with normal typing. timeout-ms is the only delay a lone J
		// ever sees (45ms, vs the 1000ms a vim inoremap would cost), and
		// require-prior-idle-ms disables the combo entirely mid-word, so
		// there is no delay at all while you're actually typing.
		combo_esc {
			timeout-ms = <45>;
			require-prior-idle-ms = <50>;
			key-positions = <16 17>;
			bindings = <&kp ESC>;
			layers = <BASE>;
		};

		// J + L -> Enter. Right hand only, so Enter no longer needs the left
		// thumb for the Mods layer. Index + ring skipping the middle: an easy
		// pinch, and "jl" appears 8 times in a 236k-word dictionary.
		combo_enter {
			timeout-ms = <45>;
			require-prior-idle-ms = <50>;
			key-positions = <16 18>;
			bindings = <&kp ENTER>;
			layers = <BASE>;
		};

		// left index & middle fingers (home-row)
		// was Ctrl+Space for duckyb's Adobe workflow.
		// On macOS Ctrl+Space switches input source -- change or delete if unwanted.
		combo_ctrl_space {
			timeout-ms = <200>;
			key-positions = <12 13>;
			bindings = <&kp LC(SPACE)>;
			layers = <BASE>;
		};
	};

	keymap {
		compatible = "zmk,keymap";
		// Base alpha layer -- standard US QWERTY block
		default_layer {
			label = "Base";
			bindings = <
			&kp Q &kp W &kp E &kp R &kp T           &kp Y &kp U  &kp I     &kp O   &kp P
			&kp A &kp S &kp D &kp F &kp G           &kp H &kp J  &kp K     &kp L   &kp SEMI
			&kp Z &kp X &kp C &kp V &kp B           &kp N &kp M  &kp COMMA &kp DOT &kp FSLH
							&mo EXT &mo AERO                                   &kp SPACE &sl SYM
			>;
		};

		// Numbers and high frequency symbols
		// Left hand pairs open/close vertically: < >  ( )  { }  [ ]
		sym_layer {
			label = "Sym.";
			bindings = <
			&kp N1 &kp N2    &kp N3   &kp N4   &kp N5             &kp N6    &kp N7    &kp N8  &kp N9    &kp N0
			&kp LT &kp DLLR  &kp LPAR &kp LBRC &kp LBKT           &kp EQUAL &kp QMARK &kp SQT &kp MINUS &kp STAR
			&kp GT &kp PRCNT &kp RPAR &kp RBRC &kp RBKT           &kp AT    &kp EXCL  &kp DQT &kp PLUS  &kp FSLH
														&mo FNC &mo SYM2                         &trans &trans
			>;
		};

		// Main modifiers and arrow keys
		ext_layer {
			label = "Mods";
			bindings = <
			&sk LALT  &kp C_PREV &kp C_PP &kp C_NEXT &kp C_PAUSE       &kp PG_UP    &kp HOME &kp UP   &kp END   &kp CAPS
			&kp ESC   &sk LGUI   &sk LSHIFT &sk LCTRL  &kp RALT        &kp PG_DN    &kp LEFT &kp DOWN &kp RIGHT &kp DEL
			&kp LG(Z) &kp LG(X)  &kp LG(C)  &kp LG(V)  &kp TAB       &kp LA(BSPC) &kp BSPC &trans   &trans    &trans
																		&trans &kp LCTRL                         &mo FNC &kp ENTER
			>;
		};

		// Function keys with modifiers
		fnc_layer {
			label = "FRow";
			bindings = <
			&kp F1 &kp F2 &kp F3 &kp F4 &kp F5                  &kp F6 &kp F7 &kp F8 &kp F9 &kp F10
			&sk LALT &sk LGUI &sk LSHIFT &sk LCTRL &kp RALT     &kp F11 &kp F12  &kp PRINTSCREEN &trans &trans
			&kp LA(V) &none &none &kp LC(LA(H)) &kp LC(LA(L))       &none &none &none &none &none
							  &none &none                         &none &none
			>;
		};

		// Low frequency symbols.
		symbols_2_layer {
			label = "Sym.2";
			bindings = <
			&kp CARET &kp UNDER &kp HASH &kp COLON &kp SEMI            &none &none &none &none &none
			&kp GRAVE &kp TILDE &kp BSLH &kp PIPE  &kp AMPS            &none &none &none &none &none
			&none     &none     &none    &none     &none               &none &none &none &none &none
																	&none &none                         &none &none
			>;
		};

		// Aerospace window management. Hold the dedicated left inner thumb.
		// Mirrors ~/.aerospace.toml, which uses alt as its modifier.
		//
		// Hold Shift (right outer thumb while Aero is active) and you get the
		// alt-shift variant for free: numbers become move-node-to-workspace,
		// and hjkl becomes move-window instead of focus. Same pairing
		// Aerospace itself uses, so there's one rule to remember, not two.
		aero_layer {
			label = "Aero";
			bindings = <
			// Aerospace shortcuts are shifted: alt-` = ws1, alt-1 = ws2, ... alt-9 = ws0.
			// Labels below describe the destination workspace, not the number sent.
			// Left top keeps mnemonic Chrome positions: W closes and T opens a tab.
			&kp LG(LS(A)) &kp LG(W) &kp LC(LS(TAB)) &kp LC(TAB) &kp LG(T)  &kp LG(T) &kp LG(LS(A)) &kp LC(LS(TAB)) &kp LC(TAB) &kp LG(W)
			&kp LC(B) &kp LA(GRAVE) &kp LA(N1) &kp LA(N2) &kp LA(N3)      &kp LA(H) &kp LA(J) &kp LA(K) &kp LA(L) &none
			// Low-use workspaces 5–9 fill the left bottom row; right bottom holds 0 and layout/resize.
			&kp LA(N4) &kp LA(N5) &kp LA(N6) &kp LA(N7) &kp LA(N8)       &kp LA(N9) &kp LA(SLASH) &kp LA(COMMA) &kp LA(MINUS) &kp LA(EQUAL)
			// While Aero is active, right inner adds Ctrl for Herdr and right outer
			// adds Shift for moving AeroSpace windows. Their base behaviors are unchanged.
									&trans &trans                         &kp LCTRL &kp LSHIFT
			>;
		};
		// Used to change the keyboard's settings.
		settings_layer {
				label = "Sett.";
				bindings = <
				&bootloader &none &none &bt BT_CLR &bt BT_SEL 0               &bt BT_SEL 3 &none &unstick &none &bootloader
				&none &none &none &none      &bt BT_SEL 1 						  &bt BT_SEL 4 &none &none &none &none
				&studio_unlock &none &none &none      &bt BT_SEL 2               &bt BT_SEL 5 &none &none &none &studio_unlock
										&none &none                         &none &none
				>;
		};
	};
};
